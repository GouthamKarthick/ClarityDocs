# Backend API — local dev uses Vite's same-origin proxy to preserve auth cookies.
# Leave blank locally. For deployment, set this to the backend origin in Vercel.
VITE_BACKEND_URL=
# Deprecated alias (still supported): VITE_API_URL

# Frontend App — where the SPA is hosted
# Local: http://localhost:5173
# Cloud: https://clarity-docs-psi.vercel.app — set in Vercel → Settings → Environment Variables
VITE_FRONTEND_URL=http://localhost:5173
# Deprecated alias (still supported): VITE_APP_URL
