# API Base — Local or Cloud (Render)
# Local: http://localhost:4000 (also used by vite.config.ts proxy)
# Cloud: https://claritydocs.onrender.com — set this in Vercel → Settings → Environment Variables → VITE_API_URL
VITE_API_URL=http://localhost:4000

# Optional — App URL for email links (must match backend APP_URL, not used for API fetch)
# VITE_APP_URL=http://localhost:5173
