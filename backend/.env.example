PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_USER=clarity_user
DB_PASSWORD=clarity_pass
DB_NAME=clarity_docs
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
EXTRACTION_MODE=inline
# Phase 2 only
# S3_BUCKET=claritydocs-uploads-dev
# SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123/claritydocs-jobs
# AWS_REGION=ap-south-1
# AI (free tier) — single key for all providers, set in .env (not committed)
AI_PROVIDER=google
AI_MODEL=gemini-flash-latest
AI_API_KEY=
AI_CONFIDENCE_THRESHOLD=0.5
LOG_LEVEL=debug
