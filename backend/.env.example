# Server
PORT=4000
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Database — Local (docker-compose mysql:8) or Cloud (Aiven)
# Local: DB_HOST=localhost DB_USER=clarity_user DB_PASSWORD=clarity_pass
# Aiven: DB_HOST=xxx.aivencloud.com DB_PORT=12345 DB_USER=avn_admin DB_PASSWORD=*** DB_NAME=clarity_docs (Aiven → Databases → Create)
# Aiven requires SSL: DB_SSL=true (auto-enabled for aivencloud.com) + CA cert (choose one):
#  - File (local): Download CA from Aiven console → Overview → CA certificate → save as backend/ca.pem (gitignored)
#  - Env (Render): Copy CA content into DB_CA_CERT (with \n) or set DB_CA_PATH=./ca.pem
DB_HOST=localhost
DB_PORT=3306
DB_USER=clarity_user
DB_PASSWORD=clarity_pass
DB_NAME=clarity_docs
DB_SSL=false
DB_CA_PATH=./ca.pem
# For Render: paste CA cert content directly (optional, overrides file)
# DB_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Auth — JWT (generate: openssl rand -hex 32)
JWT_SECRET=change-me-please-generate-with-openssl-rand-hex-32
JWT_EXPIRY=1d
RETENTION_DAYS=30

# Email — Resend free 100/day (smtp.resend.com) for verification + password reset
# Leave SMTP_PASS blank to auto-verify emails in dev
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=onboarding@resend.dev
# Frontend URL — where the SPA is hosted (must match Vercel VITE_FRONTEND_URL)
FRONTEND_URL=http://localhost:5173
# Deprecated alias (still supported): APP_URL

# AI — Gemini free tier (single key for all providers)
AI_PROVIDER=google
AI_MODEL=gemini-flash-latest
AI_API_KEY=
AI_CONFIDENCE_THRESHOLD=0.5

# Refine worker (Phase 2 async cloud refinement)
REFINE_POLL_MS=15000
REFINE_DAILY_CAP=100

# Logs
LOG_LEVEL=debug

# Currency conversion — free, no key (Frankfurter ECB rates + open.er-api fallback)
CURRENCY_CONVERSION_URL=https://api.frankfurter.app
CURRENCY_CONVERSION_FALLBACK_URL=https://open.er-api.com/v6/latest
DISPLAY_CURRENCY=INR
CURRENCY_CONVERSION_CACHE_TTL_MS=300000
CURRENCY_CONVERSION_TIMEOUT_MS=3000
